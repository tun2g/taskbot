# apps/admin-api — the bot owner's admin API (its own process; shares MongoDB + Redis with the bot).
# Copy to apps/admin-api/.env. The server refuses to start if a required value is missing.

# ── Server ────────────────────────────────────────────────
ADMIN_API_PORT=3001
# Public URL of the admin app (login links point to <ADMIN_PUBLIC_URL>/login/callback). Required.
ADMIN_PUBLIC_URL=https://admin-taskbot.example.com
# Required, at least 32 random characters (e.g. `openssl rand -hex 32`). Changing it signs everyone out.
ADMIN_SESSION_SECRET=

# ── Telegram ──────────────────────────────────────────────
# Same token as the bot (used to DM login links and post approval notices). Required.
BOT_TOKEN=
TELEGRAM_API_URL=https://api.telegram.org
# Your numeric Telegram user id — the ONLY person who can sign in. Required.
# Start a private chat with the bot first, or it can't DM you the login link.
BOT_OWNER_TELEGRAM_ID=
# Optional, same values as the bot. WEBAPP_URL (https) gives the group's "approved" message its Open board button when
# the bot has no Main Mini App in BotFather (with one, the t.me/<bot>?startapp link is used and this isn't needed).
WEBAPP_URL=
# How groups can reach you (e.g. @yourname), shown on the "not approved" and "paused" notices. Unset = no contact line.
OWNER_CONTACT=

# ── Data (same as the bot) ────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/tbot
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0

# AI provider, model and daily limits are not set here: the bot reports its model on startup, and limits are
# edited on the admin app's Settings page.

# development: cookie without Secure, Origin check off (Vite dev server on another port).
NODE_ENV=development
