# Only VITE_-prefixed vars reach the client; they are baked in at build time (local dev / fallback).
# The Docker image also reads API_URL and BOT_USERNAME from the container env at startup
# (written to /config.js), which take precedence — see apps/web/docker/40-runtime-config.sh.

# Bot REST API base URL. In production the reverse proxy serves it same-origin at /api.
VITE_API_URL=http://localhost:3000/api

# Bot username without "@" — used by the Telegram Login Widget when the board is opened in a
# normal browser. Also run /setdomain in @BotFather with the web domain.
VITE_BOT_USERNAME=
