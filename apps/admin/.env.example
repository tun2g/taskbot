# Only VITE_-prefixed vars reach the client; they are baked in at build time.
# The admin API is always same-origin at /api (Vite proxies it to http://localhost:3001 in dev).

# Dev only: serve fixture data from src/mocks instead of calling the API (`pnpm dev:mock` sets it).
# Ignored by production builds.
VITE_ADMIN_MOCK=
