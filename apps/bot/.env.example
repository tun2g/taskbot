# apps/bot — Telegram bot + REST API (they run in one process, so they share this file).
# Copy to apps/bot/.env. The web app has its own: apps/web/.env.example.

# ── Telegram ──────────────────────────────────────────────
# From @BotFather — required.
BOT_TOKEN=
TELEGRAM_API_URL=https://api.telegram.org
# Optional: the bot reads its username from getMe at startup.
BOT_USERNAME=

# ── API server ────────────────────────────────────────────
# Mini App URL — must be HTTPS for Telegram buttons and deep links; also the allowed CORS origin.
WEBAPP_URL=https://taskbot.example.com
# Set to use webhook mode (Telegram calls <WEBHOOK_URL>/api/bot/webhook); unset = polling.
WEBHOOK_URL=
PORT=3000
# Public URL of the MCP server for Claude Code / Cursor (shown by /mcp and the tokens page).
# Defaults to <WEBHOOK_URL>/mcp; set it when the API is reachable at another address.
MCP_PUBLIC_URL=

# ── Data ──────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/tbot
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0

# ── AI (/task extraction, /ai, web "Ask AI") ──────────────
# gemini | fuse. Without a key, /task still creates a basic task and /ai says AI is unavailable.
AI_PROVIDER=gemini
AI_API_KEY=
# Gemini model (default gemini-3.5-flash-lite — cheapest current tier)
AI_MODEL=gemini-3.5-flash-lite
FUSE_API_URL=https://api.fuseapi.app/v1/chat/completions

# ── Behaviour ─────────────────────────────────────────────
# Default group timezone: due dates, "overdue", reminders, 9:00 daily digest.
TIMEZONE=Asia/Ho_Chi_Minh

# Optional secret for the API's browser-login tokens (Telegram Login Widget). Derived from BOT_TOKEN if unset;
# set it to rotate web sessions without changing the bot token.
WEB_AUTH_SECRET=

NODE_ENV=development
