# apps/bot — Telegram bot + REST API (they run in one process, so they share this file).
# Copy to apps/bot/.env. The web app has its own: apps/web/.env.example.

# ── Telegram ──────────────────────────────────────────────
# From @BotFather — required.
BOT_TOKEN=
TELEGRAM_API_URL=https://api.telegram.org
# Optional: the bot reads its username from getMe at startup.
BOT_USERNAME=
# Your numeric Telegram user id (ask @userinfobot). New groups wait until you approve them: the bot DMs you
# an Approve / Reject card (open a private chat with the bot and tap Start once so it can).
# Empty = no approval step, every new group is approved automatically.
BOT_OWNER_TELEGRAM_ID=
# Optional: public URL of the admin app (the admin API's ADMIN_PUBLIC_URL). Your new-group cards and AI alert DMs
# then link straight to the group / AI page there.
ADMIN_URL=
# Optional: how a group can reach you, e.g. @yourname or an email. Shown on the "not approved" and "paused" notices
# (after a rejection the bot has left, so this is the group's only way to ask). Unset = no contact line.
OWNER_CONTACT=

# ── API server ────────────────────────────────────────────
# Mini App URL — must be HTTPS for Telegram buttons and deep links; also the allowed CORS origin.
WEBAPP_URL=https://taskbot.example.com
# Set to use webhook mode (Telegram calls <WEBHOOK_URL>/api/bot/webhook); unset = polling.
WEBHOOK_URL=
PORT=3000
# Public URL of the MCP server for Claude Code / Cursor (shown by /mcp and the tokens page).
# Defaults to <WEBHOOK_URL>/mcp; set it when the API is reachable at another address.
MCP_PUBLIC_URL=

# ── Data ──────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/tbot
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0

# ── AI (/task extraction, /ai, web "Ask AI") ──────────────
# gemini | openai | fuse. Without a key, /task still creates a basic task and /ai says AI is unavailable.
AI_PROVIDER=gemini
AI_API_KEY=
# Model id; defaults per provider: gemini-3.5-flash-lite (gemini), gpt-5-mini (openai)
AI_MODEL=gemini-3.5-flash-lite
# openai | fuse: base URL of any OpenAI-compatible endpoint (OpenRouter, Groq, vLLM, Ollama...).
# Empty = provider default (https://api.openai.com/v1, https://api.fuseapi.app/v1). Ignored by gemini.
AI_API_URL=
# Optional bot-wide cap on AI calls per day (cost circuit breaker). 0 / empty = no cap.
# Only a fallback for installs without the admin app — with it, set limits on the admin Settings page.
AI_DAILY_LIMIT=

# ── Behaviour ─────────────────────────────────────────────
# Default group timezone: due dates, "overdue", reminders, 9:00 daily digest.
TIMEZONE=Asia/Ho_Chi_Minh

# Optional secret for the API's browser-login tokens (Telegram Login Widget). Derived from BOT_TOKEN if unset;
# set it to rotate web sessions without changing the bot token.
WEB_AUTH_SECRET=

NODE_ENV=development
