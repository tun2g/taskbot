{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "src/*": ["./src/*"]
    },
    // Listed explicitly: TypeScript 6 no longer auto-includes every @types package
    "types": ["node", "jest"],
    "noImplicitAny": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src"],
  "references": [
    { "path": "../../packages/shared" }
  ]
}
